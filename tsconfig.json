{
	"include": ["src", "import-meta-env.polyfill.ts", "global.d.ts"],
	"exclude": ["node_modules"],
	"types": ["react"],
	"compilerOptions": {
		"module": "esnext",
		"lib": ["dom", "esnext"],
		"importHelpers": true,
		"declaration": true,
		"sourceMap": true,
		"rootDir": "./src",
		"outDir": "./dist2",
		"strict": true,
		"resolveJsonModule": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"noUnusedParameters": true,
		"moduleResolution": "node",
		"jsx": "react",
		"esModuleInterop": true,
		"skipLibCheck": true
	}
}
