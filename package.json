{
	"name": "@jointlabs/chains-info",
	"version": "0.0.25",
	"type": "module",
	"engines": {
		"node": ">=18.17.1"
	},
	"description": "Information about chains supported by Joint interface and supporting applications. ",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		},
		"./next": {
			"import": "./dist/nextjs/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/nextjs/index.d.ts"
		}
	},
	"license": "MIT",
	"scripts": {
		"build": "rimraf dist && tsup && yarn build-cjs && yarn build-nextjs",
		"build-cjs": "tsup --config=tsup.config.cjs.ts",
		"build-nextjs": "tsup --config=tsup.config.nextjs.ts"
	},
	"dependencies": {
		"lodash": "^4.17.21",
		"react": "^18.2.0",
		"viem": "^1.20.0"
	},
	"devDependencies": {
		"@types/react": "^18.2.39",
		"prettier": "^3.1.0",
		"replace-in-file": "^7.0.2",
		"rifraf": "^2.0.3",
		"tsup": "^8.0.1"
	},
	"peerDependencies": {
		"viem": "^1.20.0"
	}
}
